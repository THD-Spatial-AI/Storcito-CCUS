# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api

# Self-hosted Cesium quantized-mesh terrain for the 3D view (license-clean — no
# Cesium ion). Served by platform-core/terrain. Leave unset to fall back to the
# smooth ellipsoid (still a 3D perspective, no real elevation).
VITE_CESIUM_TERRAIN_URL=http://localhost:8003/terrain
# Self-hosted Sentinel-2 basemap for the 3D view.
VITE_CESIUM_SATELLITE_URL=http://localhost:8003/satellite
